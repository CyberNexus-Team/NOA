    {
      "parameters": {
        "jsCode": "const raw = $json.query?.name ?? 'report';\nconst name = String(raw).trim();\nconst safe = name.replace(/[^a-z0-9-_]/gi, '-').replace(/-+/g, '-');\nconst theme = 'light';\nconst file = `/data/reports/${safe}_${theme}.html`;\nconst filename = `${safe}.docx`;\nreturn [{ json: { name: safe, file, filename } }];"
      },
