      "name": "HTML → DOCX",
      "id": "3b559306-1a6b-46c5-95ed-e9833765a92e"
    },
    {
      "parameters": {
        "jsCode": "// Normalizza il nome del file e imposta i percorsi per HTML e DOCX\n\nconst raw = $json.query?.name ?? 'report';\nconst name = String(raw).trim();\n\n// Rimuove caratteri non validi dal nome\nconst safe = name.replace(/[^a-z0-9-_]/gi, '-').replace(/-+/g, '-');\n\n// Tema o variante (opzionale)\nconst theme = 'light';\n\n// Percorso completo del file HTML da leggere e convertire\n// Gotenberg richiede estensione .html per riconoscere correttamente il formato\nconst file = `/data/reports/${safe}_${theme}.html`;\n\n// Nome finale del documento esportato\nconst filename = `${safe}.docx`;\n\n// Restituisce i valori per i nodi successivi\nreturn [\n  {\n    json: {\n      name: safe,\n      file,\n      filename\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "name": "Normalizza Input (DOCX)1",
      "id": "4108564d-0b7f-4ff9-9db6-6f899bb5b69d"
    },
    {
      "parameters": {
        "respondWith": "binary",
        "responseDataSource": "set",
        "inputFieldName": "docx",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
              },
              {
                "name": "Content-Disposition",
                "value": "=attachment; filename=\"{{$binary.docx.fileName?.replace('.html','.docx') || ($json.name || 'report') + '.docx'}}\""
              }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
